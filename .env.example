# SIGNAL environment variables
# Copy this file to .env.local for local dev, or set these in the Vercel
# dashboard (Project > Settings > Environment Variables) for deployment.

# Required for the geopolitical briefing panel (/api/geo).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: extra news-wire coverage via Finnhub (/api/wire).
# Leave blank to skip. Get one at https://finnhub.io/
FINNHUB_API_KEY=
